{
  "name": "@platform/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "build:phase1": "tsc -p tsconfig.phase1.json",
    "typecheck": "tsc -b --pretty false",
    "lint": "prettier --check src",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "production:verify": "tsx src/production-verify.ts",
    "provision:production-roles": "tsx scripts/provision-production-roles.ts",
    "converge:production-grants": "tsx src/converge-production-grants.ts",
    "restore:verify": "tsx src/restore-verify.ts",
    "pilot:bootstrap": "tsx src/bootstrap-pilot-tenant.ts",
    "phase1:postgres": "tsx scripts/phase1-postgres.ts",
    "check": "tsx src/check.ts"
  },
  "dependencies": {
    "@platform/config": "0.1.0",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.27.1",
    "@types/node": "^22.10.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
