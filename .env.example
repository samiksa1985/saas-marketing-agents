NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# LOCAL DEVELOPMENT / ACCEPTANCE ONLY — NEVER PRODUCTION.
# The token itself belongs only in an external local file, never in this file.
LOCAL_ACCEPTANCE_AUTH_ENABLED=false
LOCAL_ACCEPTANCE_AUTH_TOKEN_FILE=
LOCAL_ACCEPTANCE_AUTH_TENANT_ID=
LOCAL_ACCEPTANCE_AUTH_USER_ID=
ARTIFACT_BUCKET=platform-artifacts
ARTIFACT_ENDPOINT=http://localhost:9000
AI_PROVIDER=mock
AI_MODEL=foundation-mock

# Governed Google Ads execution. DISABLED is the safe default.
GOOGLE_ADS_EXECUTION_MODE=DISABLED
GOOGLE_ADS_EXECUTION_ENABLED=false
# Pin a supported REST version. REAL mode requires the approved customer ID to
# also appear in the explicit numeric test-account allowlist below.
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_SANDBOX_CUSTOMER_IDS=
# Required only for explicitly approved REAL mode. Inject from a managed secret
# store; do not put real values in this file or repository-local .env files.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Governed Meta Ads execution. Both switches stay fail-closed by default.
# REAL mode requires exactly one approved ad account in the explicit sandbox
# allowlist. Inject META_ADS_ACCESS_TOKEN only through a managed secret store.
META_ADS_EXECUTION_MODE=DISABLED
META_ADS_EXECUTION_ENABLED=false
META_ADS_API_VERSION=v21.0
META_ADS_SANDBOX_AD_ACCOUNT_IDS=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_BUSINESS_ID=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Optional explicit monorepo root for runtime registry discovery.
# Useful when API process cwd is a workspace directory.
REPOSITORY_ROOT=
