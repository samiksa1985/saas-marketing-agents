NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
# Production requires a separate public HTTPS API origin.
API_PUBLIC_URL=http://localhost:4000
# Production requires an HTTPS web origin, explicit CORS origins, proxy trust
# posture, and a deployment-provided release version. Never put secrets here.
RELEASE_VERSION=development
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=false
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_METRICS_TOKEN=
OBSERVABILITY_METRICS_TOKEN_FILE=
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
# Sensitive values may use a non-empty *_FILE path instead of a direct value.
# A configured file takes precedence; unreadable or empty files fail closed.
# Production runtime and migration URLs must use sslmode=verify-full.
# Optional CA bundle path; the Compose example mounts it at /run/secrets/postgres_ca.
DATABASE_SSL_CA_FILE=
DATABASE_URL_FILE=
# Required in production for the distinct migration authority. Never inject
# this credential into API or worker runtime containers.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_URL_FILE=
# Required for production runtime-role provisioning; use a high-entropy secret.
CODECORE_APP_PASSWORD=
CODECORE_APP_PASSWORD_FILE=
# Compose file paths come from the deployment boundary and are not secret
# values. The referenced files themselves stay outside the repository.
CODECORE_POSTGRES_PASSWORD_FILE=
CODECORE_POSTGRES_CA_FILE=
CODECORE_POSTGRES_SERVER_CERT_FILE=
CODECORE_POSTGRES_SERVER_KEY_FILE=
CODECORE_RUNTIME_DATABASE_URL_FILE=
CODECORE_MIGRATION_DATABASE_URL_FILE=
# Operator-only isolated restore target; never point it at a canonical database.
ISOLATED_RESTORE_DATABASE_URL=
ISOLATED_RESTORE_DATABASE_URL_FILE=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Reserved for a future browser-login flow; not consumed by the current API.
OIDC_CLIENT_SECRET=
# LOCAL DEVELOPMENT / ACCEPTANCE ONLY — NEVER PRODUCTION.
# The token itself belongs only in an external local file, never in this file.
LOCAL_ACCEPTANCE_AUTH_ENABLED=false
LOCAL_ACCEPTANCE_AUTH_TOKEN_FILE=
LOCAL_ACCEPTANCE_AUTH_TENANT_ID=
LOCAL_ACCEPTANCE_AUTH_USER_ID=
ARTIFACT_BUCKET=platform-artifacts
ARTIFACT_ENDPOINT=http://localhost:9000
AI_PROVIDER=mock
AI_MODEL=foundation-mock

# Governed Google Ads execution. DISABLED is the safe default.
GOOGLE_ADS_EXECUTION_MODE=DISABLED
GOOGLE_ADS_EXECUTION_ENABLED=false
# Pin a supported REST version. REAL mode requires the approved customer ID to
# also appear in the explicit numeric test-account allowlist below.
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_SANDBOX_CUSTOMER_IDS=
# Required only for explicitly approved REAL mode. Keep values empty here;
# inject through a protected environment or use the *_FILE path.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN_FILE=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_SECRET_FILE=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN_FILE=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Governed Meta Ads execution. Both switches stay fail-closed by default.
# REAL mode requires exactly one approved ad account in the explicit sandbox
# allowlist. Keep token/secret values empty here; use runtime injection or
# their corresponding *_FILE paths.
META_ADS_EXECUTION_MODE=DISABLED
META_ADS_EXECUTION_ENABLED=false
META_ADS_API_VERSION=v21.0
META_ADS_SANDBOX_AD_ACCOUNT_IDS=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCESS_TOKEN_FILE=
META_ADS_AD_ACCOUNT_ID=
META_ADS_BUSINESS_ID=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_APP_SECRET_FILE=

# Optional explicit monorepo root for runtime registry discovery.
# Useful when API process cwd is a workspace directory.
REPOSITORY_ROOT=
