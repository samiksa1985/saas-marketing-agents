# Auto detect text files and normalize line endings to LF
* text=auto

# Markdown files
*.md text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.font binary

# GitHub Linguist — this is a Markdown content/knowledge repo, not a shell project.
# Count Markdown toward language stats and treat helper scripts as tooling.
*.md linguist-detectable=true
*.md linguist-documentation=false
scripts/*.sh linguist-vendored=true
